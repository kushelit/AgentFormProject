rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function userDoc() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
    }

    // Same definition as firestore.rules: non-anonymous with a known role.
    function isRegistered() {
      return isSignedIn() && !isAnonymous()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().data.get("role", "") in ["agent", "manager", "worker", "admin"];
    }

    // role/isSystem are now protected in firestore.rules, so this is trustworthy.
    function isAdminOrSystem() {
      return isRegistered()
        && (
          userDoc().data.role == "admin"
          || userDoc().data.get("isSystem", false) == true
        );
    }

    match /commission-imports/{uid}/{allPaths=**} {
      allow read: if isRegistered()
        && (
          request.auth.uid == uid
          || isAdminOrSystem()
        );

      allow write: if isRegistered()
        && request.auth.uid == uid;
    }

    match /portalRuns/{uid}/{runId}/{allPaths=**} {
      allow read: if isRegistered()
        && (
          request.auth.uid == uid
          || isAdminOrSystem()
        );

      allow write: if isRegistered()
        && request.auth.uid == uid;
    }

    function isSystem() {
      return isRegistered() && userDoc().data.get("isSystem", false) == true;
    }

    // Customer / lead documents: no direct browser access. Uploads go through the server, and
    // viewing uses short-lived signed links from /api/files/signed-urls (per-agent permission check).
    match /leadFiles/{allPaths=**} {
      allow read: if isSystem();
      allow write: if false;
    }

    match /customerFiles/{allPaths=**} {
      allow read: if isSystem();
      allow write: if false;
    }
  }
}
